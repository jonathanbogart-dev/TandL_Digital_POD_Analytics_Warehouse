# ============================================================
# T&L Digital POD Analytics Warehouse — Environment Variables
# ============================================================
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ============================================================

# ------------------------------------------------------------
# PostgreSQL (local dev via docker-compose)
# ------------------------------------------------------------
POSTGRES_USER=pod_user
POSTGRES_PASSWORD=pod_password
POSTGRES_DB=pod_warehouse
DATABASE_URL=postgresql://pod_user:pod_password@localhost:5432/pod_warehouse

# ------------------------------------------------------------
# Printful
# https://developers.printful.com/docs/
# ------------------------------------------------------------
PRINTFUL_API_KEY=

# ------------------------------------------------------------
# Printify
# https://printify.com/app/developer/docs
# ------------------------------------------------------------
PRINTIFY_API_KEY=
PRINTIFY_SHOP_ID=

# ------------------------------------------------------------
# Etsy
# https://developer.etsy.com/documentation/
# ------------------------------------------------------------
ETSY_API_KEY=
ETSY_API_SECRET=
ETSY_SHOP_ID=
ETSY_REDIRECT_URI=

# ------------------------------------------------------------
# Shopify
# https://shopify.dev/docs/api
# ------------------------------------------------------------
SHOPIFY_STORE_URL=yourstore.myshopify.com
SHOPIFY_ACCESS_TOKEN=

# ------------------------------------------------------------
# Stripe
# https://stripe.com/docs/api
# ------------------------------------------------------------
STRIPE_SECRET_KEY=

# ------------------------------------------------------------
# FastAPI backend
# ------------------------------------------------------------
API_ENV=development
API_HOST=0.0.0.0
API_PORT=8000

# ------------------------------------------------------------
# Airflow
# Generate fernet key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# ------------------------------------------------------------
AIRFLOW__CORE__FERNET_KEY=
AIRFLOW__WEBSERVER__SECRET_KEY=change_me_in_production
AIRFLOW__DATABASE__SQL_ALCHEMY_CONN=postgresql+psycopg2://pod_user:pod_password@localhost:5432/airflow
