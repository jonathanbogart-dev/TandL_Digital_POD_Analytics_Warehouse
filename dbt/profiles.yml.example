pod_analytics:
  target: dev
  outputs:
    dev:
      type: postgres
      host: localhost
      port: 5432
      user: "{{ env_var('POSTGRES_USER', 'pod_user') }}"
      password: "{{ env_var('POSTGRES_PASSWORD', 'pod_password') }}"
      dbname: "{{ env_var('POSTGRES_DB', 'pod_warehouse') }}"
      schema: public
      threads: 4
      keepalives_idle: 0

    prod:
      type: postgres
      host: "{{ env_var('PROD_DB_HOST') }}"
      port: 5432
      user: "{{ env_var('PROD_DB_USER') }}"
      password: "{{ env_var('PROD_DB_PASSWORD') }}"
      dbname: "{{ env_var('PROD_DB_NAME') }}"
      schema: public
      threads: 8
      keepalives_idle: 0
